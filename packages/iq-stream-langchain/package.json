{
  "name": "@neuron-core/iq-stream-langchain",
  "version": "0.1.0",
  "description": "Publish a LangChain JS or LangGraph.js run to an IQ-Stream server, as AI SDK UI message chunks or as LangGraph protocol events",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuron-core/iq-stream-js.git",
    "directory": "packages/iq-stream-langchain"
  },
  "homepage": "https://github.com/neuron-core/iq-stream-js",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "default": "./dist/ai-sdk/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node ../../scripts/run-tests.mjs test/unit",
    "test:integration": "node ../../scripts/run-tests.mjs test/integration --test-concurrency=1",
    "test:browser": "node ../../scripts/run-tests.mjs test/browser --test-concurrency=1",
    "prepublishOnly": "npm run build --prefix ../iq-stream && npm run build && npm run test:unit"
  },
  "peerDependencies": {
    "@ai-sdk/langchain": ">=3",
    "@langchain/core": ">=1",
    "@langchain/langgraph": ">=1.7",
    "@neuron-core/iq-stream": "^0.1.0",
    "ai": ">=7"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/langchain": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@ai-sdk/langchain": "3.0.172",
    "@ai-sdk/react": "4.0.176",
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.4",
    "@neuron-core/iq-stream": "^0.1.0",
    "@types/node": "26.6.6",
    "ai": "7.0.172",
    "esbuild": "0.28.2",
    "langchain": "1.6.6",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
