{
  "name": "@neuron-core/iq-stream-mastra",
  "version": "0.1.1",
  "description": "Publish a Mastra agent's answer to browsers through an IQ-Stream server: a chat route for Mastra's server, and the same as plain functions",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuron-core/iq-stream-js.git",
    "directory": "packages/iq-stream-mastra"
  },
  "homepage": "https://github.com/neuron-core/iq-stream-js",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node ../../scripts/run-tests.mjs test/unit",
    "test:integration": "node ../../scripts/run-tests.mjs test/integration --test-concurrency=1",
    "test:browser": "node ../../scripts/run-tests.mjs test/browser --test-concurrency=1",
    "prepublishOnly": "npm run build --prefix ../iq-stream && npm run build && npm run test:unit"
  },
  "peerDependencies": {
    "@ag-ui/mastra": ">=2.0.2 <3",
    "@mastra/ai-sdk": ">=1.12.0 <2",
    "@mastra/core": ">=1.83.0 <2",
    "@neuron-core/iq-stream": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@ag-ui/mastra": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.4",
    "@ag-ui/core": "1.0.4",
    "@ag-ui/mastra": "2.0.2",
    "@ai-sdk/react": "4.0.176",
    "@hono/node-server": "1.19.19",
    "@mastra/ai-sdk": "1.12.0",
    "@mastra/core": "1.83.0",
    "@mastra/hono": "1.7.25",
    "@mastra/server": "1.83.0",
    "@neuron-core/iq-stream": "^0.1.0",
    "@types/node": "26.6.6",
    "ai": "7.0.172",
    "esbuild": "0.28.2",
    "hono": "4.13.18",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
